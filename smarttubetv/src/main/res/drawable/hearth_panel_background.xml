<?xml version="1.0" encoding="utf-8"?>
<!-- Hearth's side panel (side_panel_dialog.dart): surface color, a faint outline,
     rounded on the edge facing the screen. The panel sits on the left, like Hearth's settings. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/hearth_surface"/>
    <stroke android:width="1dp" android:color="@color/hearth_outline"/>
    <corners
        android:topLeftRadius="0dp"
        android:bottomLeftRadius="0dp"
        android:topRightRadius="24dp"
        android:bottomRightRadius="24dp"/>
</shape>
