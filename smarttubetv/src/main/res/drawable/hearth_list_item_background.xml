<?xml version="1.0" encoding="utf-8"?>
<!-- Hearth's focused settings tile (focusable_settings_tile.dart): a faint fill and an accent
     outline, rounded, inset from the panel edges -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="100"
    android:exitFadeDuration="100">
    <item android:state_focused="true">
        <inset
            android:insetLeft="8dp"
            android:insetRight="8dp"
            android:insetTop="4dp"
            android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/hearth_focus_fill"/>
                <stroke android:width="2dp" android:color="?attr/hearthAccent"/>
                <corners android:radius="12dp"/>
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset
            android:insetLeft="8dp"
            android:insetRight="8dp"
            android:insetTop="4dp"
            android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/hearth_focus_fill"/>
                <corners android:radius="12dp"/>
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
