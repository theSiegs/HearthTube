<?xml version="1.0" encoding="utf-8"?>
<!-- A button on a page of its own (the empty page's "Sign in"): white with the accent ring when focused, dark glass otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <stroke android:width="3dp" android:color="?attr/hearthAccent"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3141418"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
