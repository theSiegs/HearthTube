<?xml version="1.0" encoding="utf-8"?>
<!-- A choice in the strip under the tabs (HearthRowsFragment): dark glass; the shown one is white; focus adds the accent ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <stroke android:width="3dp" android:color="@color/hearth_accent"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#B3141418"/>
            <stroke android:width="3dp" android:color="@color/hearth_accent"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C141418"/>
            <stroke android:width="1dp" android:color="#24FFFFFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
