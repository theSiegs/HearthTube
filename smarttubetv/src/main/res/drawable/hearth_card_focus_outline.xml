<?xml version="1.0" encoding="utf-8"?>
<!-- Hearth's focused card, "modern" style (focus_highlight.dart): a 2dp accent border with a 2dp black line inside it,
     following the card's rounded corners. CardFocusOutline pulses it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="2dp" android:color="?attr/hearthAccent"/>
            <corners android:radius="@dimen/lb_rounded_rect_corner_radius"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="2dp" android:color="#FF000000"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</layer-list>
