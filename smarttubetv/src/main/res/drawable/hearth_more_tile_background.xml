<?xml version="1.0" encoding="utf-8"?>
<!-- The More tile at the end of a row (MoreTilePresenter): dark glass like the chips; focus adds the accent outline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC141418"/>
            <stroke android:width="3dp" android:color="@color/hearth_accent"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99141418"/>
            <stroke android:width="1dp" android:color="#24FFFFFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
