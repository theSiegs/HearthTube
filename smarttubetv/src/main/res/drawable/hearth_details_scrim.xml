<?xml version="1.0" encoding="utf-8"?>
<!-- Shade behind the focused video's details and the big row (HearthRowsFragment): clear at the top, dark at the
     bottom, so white text reads over any wallpaper -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#E6000000"
        android:centerColor="#B3000000"
        android:endColor="#00000000"
        android:centerY="0.62"
        android:type="linear"/>
</shape>
