<?xml version="1.0" encoding="utf-8"?>

<!-- Title Logo with embedded clock -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_vertical|end"
              android:orientation="horizontal">
    <!-- Global clock: date then time in Hearth's pill (focus_aware_app_bar.dart): black 30%, 14dp corners, 1dp white 12%
         outline, 14/4dp padding; date regular, time bold, both 18sp with Hearth's shadow. NavigateTitleView puts it
         32dp from the screen's right edge, like Hearth's.
         Gone until NavigateTitleView shows the clock: this layout is inflated twice. -->
    <LinearLayout android:id="@+id/global_clock_pill"
                  android:visibility="gone"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical"
                  android:gravity="center_vertical"
                  android:orientation="horizontal"
                  android:background="@drawable/hearth_clock_pill"
                  android:paddingLeft="14dp"
                  android:paddingRight="14dp"
                  android:paddingTop="4dp"
                  android:paddingBottom="4dp">
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textSize="@dimen/browse_clock_date_size"
            android:textColor="@color/white"
            android:shadowColor="#8A000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"
            style="?attr/browseTitleTextStyle"
            android:visibility="gone" />
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/browse_clock_time_size"
            android:textColor="@color/white"
            android:shadowColor="#8A000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:textStyle="bold"
            style="?attr/browseTitleTextStyle"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center_vertical">
        <ImageView
            android:id="@+id/title_badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lb_browse_title_icon_height"
            android:maxWidth="@dimen/lb_browse_title_icon_max_width"
            android:layout_marginStart="@dimen/search_bar_right_items_margin"
            android:adjustViewBounds="true"
            android:src="@null"
            android:visibility="gone"
            style="?attr/browseTitleIconStyle"/>

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lb_browse_title_height"
            style="?attr/browseTitleTextStyle"/>
    </FrameLayout>
</LinearLayout>
