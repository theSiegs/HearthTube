<?xml version="1.0" encoding="utf-8"?>

<!-- Title Logo with embedded clock -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_vertical|end"
              android:orientation="horizontal">
    <!-- Settings gear next to the clock, like the Google TV home screen -->
    <androidx.leanback.widget.SearchOrbView
        android:id="@+id/settings_orb"
        android:nextFocusLeft="@id/exit_pip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/search_bar_right_items_margin"
        app:searchOrbIcon="@drawable/search_bar_settings_orb"
        app:searchOrbColor="@color/orb_color"
        app:searchOrbBrightColor="@color/orb_bright_color"
        app:searchOrbIconColor="@color/orb_icon_color"
        android:visibility="gone"/>

    <!-- Global clock: date then time in one pill, like the Hearth launcher's status bar.
         Gone until NavigateTitleView shows the clock: this layout is inflated twice. -->
    <LinearLayout android:id="@+id/global_clock_pill"
                  android:visibility="gone"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical"
                  android:gravity="center_vertical"
                  android:orientation="horizontal"
                  android:background="@drawable/hearth_clock_pill"
                  android:paddingLeft="14dp"
                  android:paddingRight="14dp"
                  android:paddingTop="4dp"
                  android:paddingBottom="4dp">
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textSize="@dimen/browse_clock_date_size"
            android:textColor="@color/white"
            android:shadowColor="#8A000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            style="?attr/browseTitleTextStyle"
            android:visibility="gone" />
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/browse_clock_time_size"
            android:textColor="@color/white"
            android:shadowColor="#8A000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textStyle="bold"
            style="?attr/browseTitleTextStyle"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center_vertical">
        <ImageView
            android:id="@+id/title_badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lb_browse_title_icon_height"
            android:maxWidth="@dimen/lb_browse_title_icon_max_width"
            android:layout_marginStart="@dimen/search_bar_right_items_margin"
            android:adjustViewBounds="true"
            android:src="@null"
            android:visibility="gone"
            style="?attr/browseTitleIconStyle"/>

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lb_browse_title_height"
            style="?attr/browseTitleTextStyle"/>
    </FrameLayout>
</LinearLayout>
