<?xml version="1.0" encoding="utf-8"?>

<!-- Title Logo with embedded clock -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_vertical|end"
              android:orientation="horizontal">
    <!-- Global clock: date then time as plain text over the wallpaper (shadowed), like the Hearth launcher's status bar.
         Gone until NavigateTitleView shows the clock: this layout is inflated twice. -->
    <LinearLayout android:id="@+id/global_clock_pill"
                  android:visibility="gone"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical"
                  android:gravity="center_vertical"
                  android:orientation="horizontal"
                  android:paddingRight="4dp">
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textSize="@dimen/browse_clock_date_size"
            android:textColor="@color/white"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            style="?attr/browseTitleTextStyle"
            android:visibility="gone" />
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/browse_clock_time_size"
            android:textColor="@color/white"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:fontFamily="sans-serif-medium"
            style="?attr/browseTitleTextStyle"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center_vertical">
        <ImageView
            android:id="@+id/title_badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lb_browse_title_icon_height"
            android:maxWidth="@dimen/lb_browse_title_icon_max_width"
            android:layout_marginStart="@dimen/search_bar_right_items_margin"
            android:adjustViewBounds="true"
            android:src="@null"
            android:visibility="gone"
            style="?attr/browseTitleIconStyle"/>

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lb_browse_title_height"
            style="?attr/browseTitleTextStyle"/>
    </FrameLayout>
</LinearLayout>
