<?xml version="1.0" encoding="utf-8"?>
<!-- Color scheme: Hearth. The Hearth launcher's near-black surfaces and purple accent, so moving
     between the launcher and HearthTube feels like one app. Registered in MainUIData. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Settings panel background (leanback_preference_fragment.xml) -->
    <attr name="preferencePanelBackground" format="reference|color"/>
    <!-- Settings panels on the left edge instead of the right (AppDialogFragment) -->
    <attr name="preferencePanelOnLeft" format="boolean"/>
    <!-- Focused card outline (CardFocusOutline); unset keeps leanback's white info area -->
    <attr name="cardFocusOutline" format="reference"/>

    <style name="App.Theme.Hearth.Player" parent="App.Theme.Leanback.Player">
        <!-- The chosen accent (Look and layout, or Hearth's), not a fixed purple; buffered part in soft white -->
        <item name="playbackProgressPrimaryColor">?attr/hearthAccent</item>
        <item name="playbackProgressSecondaryColor">#66FFFFFF</item>
        <item name="playbackControlsIconHighlightColor">?attr/hearthAccent</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Hearth</item>
        <item name="shelfBackground">@color/hearth_background</item>
        <item name="cardDefaultBackground">@color/hearth_surface</item>
        <item name="android:colorAccent" tools:targetApi="21">?attr/hearthAccent</item>
        <item name="cardFocusOutline">@drawable/hearth_card_focus_outline</item>
    </style>
    <style name="App.Theme.Hearth.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/hearth_background</item>
        <item name="brandColor">@color/hearth_surface</item>
        <item name="brandAccentColor">?attr/hearthAccent</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Hearth</item>
        <item name="shelfBackground">@color/hearth_background</item>
        <item name="cardDefaultBackground">@color/hearth_surface</item>
        <item name="android:colorAccent" tools:targetApi="21">?attr/hearthAccent</item>
        <item name="appLogo">@null</item>
        <item name="cardFocusOutline">@drawable/hearth_card_focus_outline</item>
        <item name="guidedStepTheme">@style/App.Theme.Hearth.GuidedStep</item>
    </style>
    <!-- Sign in and Add device: Hearth's dark surfaces and its focused settings row, not leanback's greys -->
    <style name="App.Theme.Hearth.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="guidedStepBackground">@color/hearth_background</item>
        <item name="guidedActionsBackground">@color/hearth_surface</item>
        <item name="guidedActionsBackgroundDark">@color/hearth_surface</item>
        <item name="guidedActionsSelectorDrawable">@drawable/hearth_list_item_background</item>
        <item name="guidedActionsElevation">0dp</item>
        <item name="guidedActionItemTitleStyle">@style/Hearth.GuidedActionItemTitleStyle</item>
        <item name="guidedActionItemDescriptionStyle">@style/Hearth.GuidedActionItemDescriptionStyle</item>
    </style>
    <!-- Roboto, not leanback's condensed cut, on sign in and Add device -->
    <style name="Hearth.GuidedActionItemTitleStyle" parent="Widget.Leanback.GuidedActionItemTitleStyle">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Hearth.GuidedActionItemDescriptionStyle" parent="Widget.Leanback.GuidedActionItemDescriptionStyle">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="App.Theme.Hearth.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="android:colorPrimary" tools:targetApi="21">@color/hearth_surface</item>
        <item name="android:colorAccent" tools:targetApi="21">?attr/hearthAccent</item>
        <item name="preferencePanelBackground">@drawable/hearth_panel_background</item>
        <item name="preferencePanelOnLeft">true</item>
        <!-- The title sits on the panel itself, no colored header bar -->
        <item name="defaultBrandColor">@android:color/transparent</item>
        <item name="android:selectableItemBackground">@drawable/hearth_list_item_background</item>
    </style>
    <style name="ProgressBarHorizontal.Hearth" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_hearth</item>
    </style>
</resources>
