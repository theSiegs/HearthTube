<?xml version="1.0" encoding="utf-8"?>
<!-- HearthTube variant: own launcher name, icon and banner (shown by TV launchers like Projectivy) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- The Hearth launcher's active Google TV profile (HearthProfile); invisible to us on Android 11+ without this -->
    <queries>
        <provider android:authorities="com.thesiegs.hearth.profile"/>
        <package android:name="com.thesiegs.hearth"/>
        <!-- Hearth's debug build, which a debug HearthTube also talks to -->
        <package android:name="com.thesiegs.hearth.debug"/>
        <!-- Kids profile check (ParentGate): Google TV suspends the launcher apps a parent hasn't approved -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
        </intent>
    </queries>

    <application
        android:icon="@drawable/hearthtube_icon"
        android:banner="@drawable/hearthtube_banner"
        tools:replace="android:icon,android:banner">
    </application>
</manifest>
