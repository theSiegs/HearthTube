<?xml version="1.0" encoding="utf-8"?>
<!-- HearthTube variant: own launcher name, icon and banner (shown by TV launchers like Projectivy) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- The Hearth launcher's active Google TV profile (HearthProfile); invisible to us on Android 11+ without this -->
    <queries>
        <provider android:authorities="com.thesiegs.hearth.profile"/>
        <package android:name="com.thesiegs.hearth"/>
        <!-- Hearth's debug build, which a debug HearthTube also talks to -->
        <package android:name="com.thesiegs.hearth.debug"/>
        <!-- Kids profile check (ParentGate): Google TV suspends the launcher apps a parent hasn't approved -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
        </intent>
    </queries>

    <!-- Permissions SmartTube's modules declare that HearthTube doesn't use:
         - ACTION_MANAGE_OVERLAY_PERMISSION is a settings screen's name, not a permission;
         - REQUEST_DELETE_PACKAGES only uninstalls SmartTube's "bridge" helper apps, which HearthTube never installs;
         - BLUETOOTH only read the device's Bluetooth name for a label (other names are tried, and it's refused from Android 12);
         - RECORD_AUDIO was for the in-app voice search; it goes to the TV's own voice search now (SearchData) -->
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" tools:node="remove"/>
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>

    <application
        android:icon="@drawable/hearthtube_icon"
        android:banner="@drawable/hearthtube_banner"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        tools:replace="android:icon,android:banner,android:usesCleartextTraffic,android:allowBackup">
        <!-- A file manager's "open with" or "share" of a .zip must not replace the settings, PIN and account without a
             parent (a kids profile has no gate there); restoring stays in Settings → Backup and restore -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.common.misc.BackupReceiverActivity" tools:node="remove"/>
    </application>
</manifest>
