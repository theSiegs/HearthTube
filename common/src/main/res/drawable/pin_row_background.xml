<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the shuffled PIN pad (PinDialog), and its backspace pill: the whole pill lights up on focus, as in Hearth -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pin_key_focused"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pin_key"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
