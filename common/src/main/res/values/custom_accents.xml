<?xml version="1.0" encoding="utf-8"?>
<!-- Accent colors, the Hearth launcher's 15 (settings_service.dart). Applied over every screen's theme by
     HearthAccent (Look and layout > Accent color, or Match Hearth). Hearth-style drawables use ?attr/hearthAccent. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <attr name="hearthAccent" format="color"/>

    <style name="HearthAccent.Purple" parent="">
        <item name="hearthAccent">#FF7C4DFF</item>
        <item name="android:colorAccent" tools:targetApi="21">#FF7C4DFF</item>
    </style>
