<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/pin_digit_up"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:src="@drawable/ic_pin_up"
        android:contentDescription="@null"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/pin_digit_value"
        android:layout_width="64dp"
        android:layout_height="80dp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:textSize="34sp"
        android:textColor="@color/pin_text"
        android:background="@drawable/pin_digit_background"/>

    <ImageView
        android:id="@+id/pin_digit_down"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:src="@drawable/ic_pin_down"
        android:contentDescription="@null"
        android:visibility="invisible"/>
</LinearLayout>
